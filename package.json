{
  "name": "emobuff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EmoBuff: A character studio for realtime vtubers. Clawd reads your script aloud and emotes each line, driven by a 'System One' decision model.",
  "scripts": {
    "dev": "bun --hot scripts/dev.ts",
    "app": "bun run build:css && EB_DATA_ROOT=.dev-data bun run main.ts",
    "build:css": "bunx @tailwindcss/cli -i ./src/client/styles.css -o ./src/client/generated.css --minify",
    "build": "bun run build:css && bun run build.ts",
    "build:all": "bun run build:css && bun run build.ts --all",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "bun test",
    "lint": "eslint .",
    "eval": "bun run scripts/eval.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "von-sdk": "1.1.1",
    "webview-bun": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
