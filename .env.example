# Copy to .env to configure a SOURCE run (Bun loads .env automatically).
# A compiled app reads the same variables from its environment.

# Which decision engine to load: von (default) | mock
# (`bun run dev` defaults to mock so the UI works without the 3.3 GB model.)
# EB_ENGINE=von

# Where engines keep their downloads and logs. Source runs (`bun run dev`, `app`, `eval`)
# already default to ./.dev-data; the compiled app uses the OS's per-user app data folder.
# EB_DATA_ROOT=.dev-data

# Set to 0 to turn engine downloads off entirely.
# EB_ALLOW_INSTALL=0

# Preferred port for the app window's server (falls back to a free port when taken).
# EB_APP_PORT=24850

# Port for `bun run dev` (browser UI with hot reload).
# EB_DEV_PORT=3000
